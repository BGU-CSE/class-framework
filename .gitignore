__pycache__/
*.py[cod]
.pytest_cache/
.venv/
*.egg-info/

# The framework-developer marker. Gitignored on purpose: it must never reach a
# teacher's clone, so its presence is a reliable signal of a developer checkout.
dev/.developer

# macOS Finder litter.
.DS_Store

# Claude Code's per-machine permissions file. A developer's or teacher's own settings — never
# shared (the shared ones are .claude/settings.json). Was covered only by a global excludes file
# until that was removed (D-041), so nothing in the repo kept it out.
.claude/settings.local.json

# Claude Code's worktrees for background agents (each a full checkout on its own branch). Never
# committed: a nested copy of the repo inside .claude/ would ship to every teacher's clone.
.claude/worktrees/
